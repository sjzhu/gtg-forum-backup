    {
      "id": 63489,
      "name": "Foote",
      "username": "Foote",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/foote/{size}/1877_2.png",
      "created_at": "2013-05-22T14:17:00.000Z",
      "cooked": "<p>\"The cut of your jib\"</p><p>&nbsp;</p><div><table><tbody><tr><td><div>A far classier version of \"I like your style\", originally used by pirates in the 17th century the expression refers to the forward sail on most ships. The course and speed of a ship is determined by the cut of the ships jib, so saying that you like the cut of someones jib is a way of saying, I like the way you're heading.</div></td></tr></tbody></table></div><p>Edit: Explaination was a copy and paste from somewhere. Not my own words.</p>",
      "post_number": 5,
      "post_type": 1,
      "updated_at": "2021-02-07T02:40:22.969Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 8015,
      "topic_slug": "when-does-the-pre-order-start",
      "display_username": "Foote",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
      "flair_group_id": 41,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
