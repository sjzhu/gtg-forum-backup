      "avatar_template": "/user_avatar/forums.greaterthangames.com/pwatson1974/{size}/1925_2.png",
      "created_at": "2013-04-01T20:51:19.000Z",
      "cooked": "<p>She is not a target beore she flips and so cannot be damaged, or directly affected. You can't stun bolt her to reduce damage, for example.</p>",
