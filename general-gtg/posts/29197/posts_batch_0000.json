      {
        "id": 264759,
        "name": "",
        "username": "LonelyMan",
        "avatar_template": "/letter_avatar_proxy/v4/letter/l/f4b2a3/{size}.png",
        "created_at": "2026-01-06T20:54:00.453Z",
        "cooked": "<p>I feel that the cost of nature (not natural) magic is that you have to open your senses to the rhythms of the natural world, and then you can’t ignore the constant signal, which easily becomes overwhelming and distressing.</p>",
        "post_number": 29,
