        "avatar_template": "/letter_avatar_proxy/v4/letter/a/90db22/{size}.png",
        "created_at": "2015-03-26T21:00:37.000Z",
        "cooked": "<aside class=\"quote no-group\" data-username=\"Craig\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.greaterthangames.com/user_avatar/forums.greaterthangames.com/craig/48/2150_2.png\" class=\"avatar\"> Craig:</div>\n<blockquote>\n<p>The Matriarch writes bad goth poetry. If she doesn't belong in Slytherin, something is wrong.</p>\n</blockquote>\n</aside>\n<p>Is there anything intrinsically gothy or poetic about Slytherin?</p>",
