      "id": 29264,
      "name": "Spiff",
      "username": "Spiff",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/spiff/{size}/1865_2.png",
      "created_at": "2012-08-26T17:58:45.000Z",
      "cooked": "<p>When I was creating my oversized cards, I wanted an \"H\" icon that moved in-line with the rest of the text because I thought it could be a pain to always have to reposition the \"H\" every time I made a change to the text. &nbsp;So I found a font with a cartoony H, and a dingbats font that had a circle, then adjusted the kerning in Photoshop so that the two were displayed on top of each other. &nbsp;With that, I could copy/paste my \"H\" icon into any block of text and know it would always hold its position.</p><p>Having said that, I think the actual \"H\" icon looks better than my solution.</p>",
      "post_number": 5,
      "post_type": 1,
      "updated_at": "2021-02-07T02:03:14.317Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 10,
      "readers_count": 9,
      "score": 2.0,
      "yours": false,
      "topic_id": 5692,
      "topic_slug": "sotm-fonts",
      "display_username": "Spiff",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
