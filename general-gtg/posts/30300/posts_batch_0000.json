      {
        "id": 254919,
        "name": "",
        "username": "skywhale",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/skywhale/{size}/5248_2.png",
        "created_at": "2023-10-27T13:19:40.699Z",
        "cooked": "<p>My understanding is even a noteworthy Disparation character is still a lesser known/smaller character within the Sentinels world, is that off-base? Exceptions, of course, are the Disparation characters who manage to make it into main-line stories.</p>",
        "post_number": 25,
        "post_type": 1,
        "updated_at": "2023-10-27T13:19:40.699Z",
