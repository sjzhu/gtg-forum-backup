      {
        "id": 254915,
        "name": "OddballPaladin",
        "username": "OddballPaladin",
        "avatar_template": "/letter_avatar_proxy/v4/letter/o/d26b3c/{size}.png",
        "created_at": "2023-10-27T02:20:19.627Z",
        "cooked": "<aside class=\"quote no-group\" data-username=\"Jeysie\" data-post=\"19\" data-topic=\"30300\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.greaterthangames.com/user_avatar/forums.greaterthangames.com/jeysie/48/1868_2.png\" class=\"avatar\"> Jeysie:</div>\n<blockquote>\n<p>I personally call her Princess Luminary, lol.</p>\n</blockquote>\n</aside>\n<p>I think of her as just Luminary. The real one, as I see it. Blade was just a imitation.</p>",
