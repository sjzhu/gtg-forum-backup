      "topic_slug": "hey-guys-im-back",
      "display_username": "Lord Flash Fire",
      "primary_group_name": null,
      "flair_name": null,
      "flair_url": null,
      "flair_bg_color": null,
      "flair_color": null,
      "flair_group_id": null,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
