        "avatar_template": "/letter_avatar_proxy/v4/letter/o/d26b3c/{size}.png",
        "created_at": "2022-12-20T02:22:49.769Z",
        "cooked": "<aside class=\"quote no-group\" data-username=\"The_Justifier\" data-post=\"22\" data-topic=\"29499\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.greaterthangames.com/user_avatar/forums.greaterthangames.com/the_justifier/48/4954_2.png\" class=\"avatar\"> The_Justifier:</div>\n<blockquote>\n<p>The talk of Muppets does little for me, but the idea of Tim Curry playing Baron Blake is an absolute delight. I think a Kickstarter is called for…</p>\n</blockquote>\n</aside>\n<p>I wish, but he’s largely retired after his stroke. Quite unfortunate.</p>",
