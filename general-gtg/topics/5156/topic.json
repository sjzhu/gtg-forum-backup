      {
        "id": 5158,
        "name": "The Conscience",
        "username": "The_Conscience",
        "avatar_template": "/letter_avatar_proxy/v4/letter/t/58956e/{size}.png",
        "created_at": "2011-08-31T15:10:24.000Z",
        "cooked": "<p>My local game store asked me to run lots of demos so that he could get enough interest allowing them to carry it.</p>\n<p>Lots of people have stopped by and played the game and everyone that has looked at it and played it has been asking where to get it.</p>\n<p>How have your stores been doing with SotM sales? Do you do lots of demos?</p>\n<p>Gonna keep up the push at my FLGS and local Game Fair in November, as well. Any ideas as to what kind of support a demo representative (even a volunteer one) can get for this?</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:34:44.219Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 1,
        "reads": 0,
        "readers_count": 0,
        "score": 5.0,
        "yours": false,
        "topic_id": 5156,
        "topic_slug": "been-doing-lots-of-demos",
        "display_username": "The Conscience",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
