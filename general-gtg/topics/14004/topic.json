        "score": 0.0,
        "yours": false,
        "topic_id": 14004,
        "topic_slug": "villians-of-the-multiverse-story-speculation-thoughts-ect-on-going",
        "display_username": "phantaskippy",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
