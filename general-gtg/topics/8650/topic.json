        "score": 5.0,
        "yours": false,
        "topic_id": 8650,
        "topic_slug": "quick-shout-out-to-gtg-and-a-hello-to-the-forum-folk",
        "display_username": "gamingyeti",
        "primary_group_name": null,
        "flair_name": null,
