        "username": "fjur",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/fjur/{size}/4849_2.png",
        "created_at": "2021-06-23T01:48:19.338Z",
        "cooked": "<p>It doesn’t make much sense to me for Haka to be there; I’d imagine that that version of the Freedom Four would be very patriotic-themed, and a Maori warrior would seem somewhat out of place.</p>",
        "post_number": 7,
        "post_type": 1,
        "updated_at": "2021-06-23T01:48:19.338Z",
