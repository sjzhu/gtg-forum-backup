      {
        "id": 52684,
        "name": "Indecision101",
        "username": "Indecision101",
        "avatar_template": "/letter_avatar_proxy/v4/letter/i/2bfe46/{size}.png",
        "created_at": "2013-01-29T03:24:39.000Z",
        "cooked": "<p>lol, sorry I always have so many questions, but say, for example, you draw an environment card that says AT THE START OF THE ENVIRONMENT TURN, DO ____________....do you do it right away, or wait until the next Environment turn</p>",
        "post_number": 3,
        "post_type": 1,
        "updated_at": "2021-02-07T02:26:39.238Z",
        "reply_count": 0,
        "reply_to_post_number": null,
