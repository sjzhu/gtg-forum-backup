      "name": "Gislef",
      "username": "Gislef",
      "avatar_template": "/letter_avatar_proxy/v4/letter/g/4af34b/{size}.png",
      "created_at": "2015-07-17T18:39:42.000Z",
      "cooked": "<p>Just wanted to be sure on this. The only way to trigger the Game Over condition is to remove it via reducing it to 0 HPs, right?</p><p>Simply removing it from playing, Grappling Hook, etc., doesn't trigger the game over condition.</p><p>We didn't think there was any kind of \"If this card is removed from play, it is automatically reduced to 0 HPs first\" or anything like that. But wanted to be sure.</p><p>Thanks!</p>",
      "post_number": 1,
      "post_type": 1,
      "updated_at": "2021-02-07T01:45:05.171Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 4,
      "reads": 0,
      "readers_count": 0,
      "score": 20.0,
      "yours": false,
      "topic_id": 13317,
      "topic_slug": "propulsion-systems",
