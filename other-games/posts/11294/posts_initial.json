      "id": 118290,
      "name": "Ameena",
      "username": "Ameena",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/ameena/{size}/1907_2.png",
      "created_at": "2014-09-17T00:48:02.000Z",
      "cooked": "<p>They do count as four hero <span class=\"bbcode-i\">targets</span>, though. If something hits all hero targets, they all get hit. If something hits all <span class=\"bbcode-i\">heroes</span>, only one of them will (your choice). If they didn't count as a single hero then stuff like Plague Rat's flip mechanic would be messed up (because he'd never be able to Infect everyone).</p>",
      "post_number": 5,
      "post_type": 1,
      "updated_at": "2021-02-07T03:51:10.803Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 11294,
      "topic_slug": "the-sentinels-and-h-value",
      "display_username": "Ameena",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
      "flair_group_id": 41,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
