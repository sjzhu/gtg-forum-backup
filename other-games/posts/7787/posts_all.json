    {
      "id": 60982,
      "name": "Ronway",
      "username": "Ronway",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/ronway/{size}/1856_2.png",
      "created_at": "2013-04-25T02:55:03.000Z",
      "cooked": "<p>Fixed Point makes all other cards other than itself indestructible. Indestructible includes being removed from play, thus playing a second plating would attempt to move the first plating from play back into hand, but as it is indestructible it wouldn't be able to.</p>",
      "post_number": 8,
