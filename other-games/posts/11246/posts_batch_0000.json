      {
        "id": 117256,
        "name": "Killswitch",
        "username": "Killswitch",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/killswitch/{size}/2116_2.png",
        "created_at": "2014-10-01T13:41:56.000Z",
        "cooked": "<p>Ok, so I have a follow-up question to this. In Time Cataclysm, Fixed Point prevents destruction. Can a target be reduced to 0 HP? If so, does it automatically go poof once the environment is destroyed (as it is the only exception)?</p>",
        "post_number": 35,
        "post_type": 1,
        "updated_at": "2021-02-07T03:49:54.463Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 1,
        "readers_count": 0,
        "score": 0.2,
        "yours": false,
        "topic_id": 11246,
        "topic_slug": "do-when-destroyed-triggers-happen-when-cards-are-removed-from-the-game",
        "display_username": "Killswitch",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
