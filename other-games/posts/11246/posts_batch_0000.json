      {
        "id": 117257,
        "name": "Pydro",
        "username": "Pydro",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/pydro/{size}/1844_2.png",
        "created_at": "2014-10-01T13:47:01.000Z",
        "cooked": "<p>Yep. In fact there has been a ruling that you can go into negatives with Fixed Point. However, it isn't destroyed if it can bring its hp to at least 1 before Fixed Point leaves.</p>",
        "post_number": 36,
        "post_type": 1,
        "updated_at": "2021-02-07T03:49:54.542Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 1,
        "readers_count": 0,
        "score": 0.2,
        "yours": false,
        "topic_id": 11246,
        "topic_slug": "do-when-destroyed-triggers-happen-when-cards-are-removed-from-the-game",
        "display_username": "Pydro",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
