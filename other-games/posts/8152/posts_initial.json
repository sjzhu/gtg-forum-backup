      "id": 65249,
      "name": "TheJayMann",
      "username": "TheJayMann",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/thejaymann/{size}/2261_2.png",
      "created_at": "2013-06-04T23:53:13.000Z",
      "cooked": "<p>Legacy gets to reduce the damage by one only if he is to take the damage.&nbsp; Once that damage is redirected to someone else, he is no longer taking the damage, and thus is damage reduction does not apply (damage modifiers typically stick to the damage dealer and taker, not the damage itself).</p>",
      "post_number": 4,
      "post_type": 1,
      "updated_at": "2021-02-07T02:42:37.631Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
