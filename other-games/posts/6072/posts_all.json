      "topic_id": 6072,
      "topic_slug": "subzero-atmosphere-when-why",
      "display_username": "flamethrower49",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
      "flair_group_id": 41,
      "badges_granted": [],
      "version": 1,
