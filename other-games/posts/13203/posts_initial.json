    {
      "id": 143292,
      "name": "Donner",
      "username": "Donner",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/donner/{size}/1903_2.png",
      "created_at": "2015-06-28T15:51:01.000Z",
      "cooked": "<p>That actually came up in the PAX South tournament.&nbsp; Ambuscade tried to commit suicide through his own remote drone.&nbsp; It was ruled that he could not hurt himself that way.</p>",
      "post_number": 9,
      "post_type": 1,
      "updated_at": "2021-02-07T04:20:41.684Z",
