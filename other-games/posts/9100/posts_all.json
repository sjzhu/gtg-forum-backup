      "id": 83722,
      "name": "Ameena",
      "username": "Ameena",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/ameena/{size}/1907_2.png",
      "created_at": "2013-12-05T13:41:30.000Z",
      "cooked": "<p>A card's effect will only stay in effect after the card is gone if the effect has a specific duration which hasn't been met yet. For example, I think the power on Ra's Flesh of the Sun God makes all heroes immune to fire until the start of Ra's next turn. If Ra used that power on his turn but was then incapacitated, everyone would still be immune to fire until Ra's next turn came around. The same goes for effects caused by a target (such as Akash'Bhuta's Ensnaring Brambles) if the target is destroyed between turns.</p>",
      "post_number": 3,
      "post_type": 1,
      "updated_at": "2021-02-07T03:06:53.115Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 9100,
      "topic_slug": "hakas-ground-pound",
      "display_username": "Ameena",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
