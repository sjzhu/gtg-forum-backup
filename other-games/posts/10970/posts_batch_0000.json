        "avatar_template": "/user_avatar/forums.greaterthangames.com/bunston/{size}/1939_2.png",
        "created_at": "2015-11-26T18:42:15.000Z",
        "cooked": "<aside class=\"quote no-group\" data-username=\"Objulen\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n<img loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.greaterthangames.com/letter_avatar_proxy/v4/letter/o/779978/48.png\" class=\"avatar\"> Objulen:</div>\n<blockquote>\n<p>I wonder – can we mix and match the promo sentinels with the regular ones?</p>\n</blockquote>\n</aside>\n<p>I don't see any reason why you couldn't.</p>",
