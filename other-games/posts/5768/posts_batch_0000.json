        "avatar_template": "/letter_avatar_proxy/v4/letter/s/3ec8ea/{size}.png",
        "created_at": "2012-05-17T17:30:31.000Z",
        "cooked": "<p>As Smoke Bombs seriously has some problems as it is currently written (you must redirect damage, you cannot choose not to, and you cannot (without outside means) destroy the card) I say any way you can game it is AOK with me.</p>",
        "post_number": 23,
        "post_type": 1,
        "updated_at": "2021-02-07T02:04:19.530Z",
        "reply_count": 0,
        "reply_to_post_number": null,
