      "id": 126636,
      "name": "phantaskippy",
      "username": "phantaskippy",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/phantaskippy/{size}/1897_2.png",
      "created_at": "2015-01-10T16:16:00.000Z",
      "cooked": "<p>Try Fixer with Skyscraper.</p><p>Use Micro-Assembler to get Jackhandle.</p><p>Use Compulsion Canister to deal 2 irreducible damage to all non-hero targets. &nbsp;Twice.</p><p><span>Micro Assembler also lets you have turns where you play Charge then put Grease Gun into play from your deck.</span></p><p>DW Fixer + Tiny Sky-Scraper is amazing, since she can return 2 links from the trash, and only 1 from the field destroying Compulsion Canisters is actually a positive.</p><p><span>I believe the alternate title for</span><span>&nbsp;</span><em>Wrath of the Cosmos</em><span>&nbsp;</span><span>is</span><span>&nbsp;</span><em>Rise of the Fixer.</em></p>",
      "post_number": 7,
      "post_type": 1,
      "updated_at": "2021-02-07T04:01:07.008Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 11877,
      "topic_slug": "mr-fixer-overdrive-cosmic-weapon-question",
