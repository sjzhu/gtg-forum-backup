      "avatar_template": "/user_avatar/forums.greaterthangames.com/powerhound_2000/{size}/1859_2.png",
      "created_at": "2017-04-17T14:12:05.000Z",
      "cooked": "<p>Not quite true as all Reactive Plating cares about is that Omnitron-X took a damage of a type on a plating card and it lists what his reaction damage is. &nbsp; If Mr Fixer deals out damage due to Jack Handle or Dual Crowbars from Infection that damage gains Irreducible. &nbsp;&nbsp;</p>",
      "post_number": 6,
      "post_type": 1,
      "updated_at": "2021-02-07T05:23:38.890Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 1,
