    {
      "id": 95481,
      "name": "Christopher",
      "username": "Christopher",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/christopher/{size}/1851_2.png",
      "created_at": "2014-03-11T17:01:37.000Z",
      "cooked": "<p>Yes, Incapacitated Heroes do still have turns, but they don't have hands or decks! Not that it matters for this question, but relatedly, an Incapacitated Hero cannot discard their hand to resolve an effect. Just FYI.</p>",
      "post_number": 4,
      "post_type": 1,
      "updated_at": "2021-02-07T03:22:19.810Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 9857,
      "topic_slug": "skip-a-turn-when-incapacitated",
      "display_username": "Christopher",
      "primary_group_name": null,
      "flair_name": null,
