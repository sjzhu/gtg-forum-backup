      "id": 84207,
      "name": "dpt",
      "username": "dpt",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/dpt/{size}/1922_2.png",
      "created_at": "2013-12-14T02:55:40.000Z",
      "cooked": "<p>Investigate has two steps: deal damage and then draw cards. They happen one after the other, so since the Amulet discard is in response to the damage, it has to happen before the draw.</p>",
      "post_number": 2,
      "post_type": 1,
      "updated_at": "2021-02-07T03:07:31.279Z",
      "reply_count": 0,
      "reply_to_post_number": null,
