      "username": "dlott1988",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/dlott1988/{size}/2135_2.png",
      "created_at": "2014-07-26T00:17:00.000Z",
      "cooked": "<p>Sometimes cards say \"discard the top card of your deck.\"&nbsp;</p><p>So, since this has become a place to discuss the most particularly specific semantics, we should update the definition of Discard and Destroy.</p><p>Discard- When a card not yet revealed (face-down) card is placed into the appropriate Trash.</p><p>Destroy- When a revealed (face-up) card is placed into the appropriate Trash.</p>",
      "post_number": 7,
      "post_type": 1,
      "updated_at": "2021-02-07T03:34:48.792Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 10384,
      "topic_slug": "destroyed-vs-discarded",
      "display_username": "dlott1988",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
