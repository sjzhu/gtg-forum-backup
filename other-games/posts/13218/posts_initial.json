      "username": "Matchstickman",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/matchstickman/{size}/1880_2.png",
      "created_at": "2015-06-30T21:52:00.000Z",
      "cooked": "<p>Yes. Individually. So Squall isn't one 5 Point attack, it's five 1 point attacks (if there were five targets in play for example).</p>",
      "post_number": 2,
      "post_type": 1,
      "updated_at": "2021-02-07T04:21:00.725Z",
