        "avatar_template": "/letter_avatar_proxy/v4/letter/p/51bf81/{size}.png",
        "created_at": "2015-07-22T19:58:43.000Z",
        "cooked": "<p>Does the new side take place immediately, or does the villain card get moved to the end of the effect chain as \"newest card in play\"?</p>",
        "post_number": 33,
        "post_type": 1,
        "updated_at": "2021-02-07T04:02:39.452Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
