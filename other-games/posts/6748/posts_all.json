      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 6748,
      "topic_slug": "drakes-pipes-what-is-a-different-melody-card",
      "display_username": "Matchstickman",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
      "flair_group_id": 41,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
