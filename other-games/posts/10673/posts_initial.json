      "id": 108465,
      "name": "LevelUpLeo",
      "username": "LevelUpLeo",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/levelupleo/{size}/2394_2.png",
      "created_at": "2014-07-05T13:49:44.000Z",
      "cooked": "<p>Side question to this: are there any instances where multiple damage types (ex;&nbsp;<span>radiant and melee) are considered to be only one instance of damage?</span></p>",
      "post_number": 6,
      "post_type": 1,
      "updated_at": "2021-02-07T03:38:57.598Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 10673,
      "topic_slug": "doubled-damage-modifiers",
