      "id": 12112,
      "name": "dpt",
      "username": "dpt",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/dpt/{size}/1922_2.png",
      "created_at": "2015-01-26T17:04:15.000Z",
      "cooked": "<p>It's been clarified many times that when a deck runs out of cards and you need to play or discard from that deck, you reshuffle the trash into the deck; but you don't do this when you need to, for instance, reveal cards from the deck. But there doesn't seem to be as prominent an official source for this as I'd expect. It's in Spiff's FAQ, but it's not in the \"official rulings\" forum, and the version of the rulebook that you can download at sentinelsofthemultiverse doesn't have any rule about reshuffling that I can see. Can we get an official ruling to this effect to point people to?</p><p>Thanks!</p>",
      "post_number": 1,
      "post_type": 1,
      "updated_at": "2021-02-07T01:43:33.869Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 1,
      "reads": 0,
      "readers_count": 0,
      "score": 5.0,
      "yours": false,
      "topic_id": 12111,
      "topic_slug": "official-source-for-reshuffling",
      "display_username": "dpt",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
