      {
        "id": 74677,
        "name": "Ronway",
        "username": "Ronway",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/ronway/{size}/1856_2.png",
        "created_at": "2013-09-29T16:24:31.000Z",
        "cooked": "<p>If damage is reduced to 0, no damage would be dealt, so anything that is triggered on damage being dealt would no trigger. It's the same with Immunity, damage is not actually dealt to the target, thus no triggers for it.</p>",
        "post_number": 2,
        "post_type": 1,
