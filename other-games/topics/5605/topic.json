        "cooked": "<pre><code class=\"lang-auto\">public class JackHandleCard : LastingCard {\n    private IDisposable _DamageTrigger = null;\n    public override PlayerType PlayerType { get { return PlayerType.Hero; } }\n    public override void Play() {\n        _DamageTrigger = this.Player.OnDamaging.Subscribe( damage =&gt; damage.Redirect(Game.AllTargets.Where(t =&gt; t.PlayerType != PlayerType.Hero)));\n    }\n\n    public override void Remove(){\n        _DamageTrigger.Dispose();\n    }\n}</code></pre>",
