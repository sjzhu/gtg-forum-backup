        "avatar_template": "/user_avatar/forums.greaterthangames.com/matchstickman/{size}/1880_2.png",
        "created_at": "2014-05-31T17:18:46.000Z",
        "cooked": "<p>The 'extra' weapon doesn't go on the tech, it's placed on the ship so the tech can be scrapped quicker when taking damage.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T03:34:58.160Z",
        "reply_count": 0,
        "reply_to_post_number": null,
