        "avatar_template": "/user_avatar/forums.greaterthangames.com/spiff/{size}/1865_2.png",
        "created_at": "2014-05-31T17:05:02.000Z",
        "cooked": "<p>This Tech card has 1W and says \"when you install this Tech, this ship gains 1W\". So then why doesn't it just have a 2W in the corner and do away with the text? I'm sure there's a nuance here I'm missing.&nbsp;</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:41:27.460Z",
        "reply_count": 0,
        "reply_to_post_number": null,
