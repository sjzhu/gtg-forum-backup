        "id": 105276,
        "name": "Ronway",
        "username": "Ronway",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/ronway/{size}/1856_2.png",
        "created_at": "2014-05-28T16:06:10.000Z",
        "cooked": "<p>No, Legacy would not be dealt any damage thanks to being immune. So the Mitigate would still reduce damage for someone else.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T03:34:50.089Z",
