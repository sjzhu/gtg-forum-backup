      {
        "id": 55132,
        "name": "dypaca",
        "username": "dypaca",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/dypaca/{size}/2079_2.png",
        "created_at": "2013-03-14T03:10:49.000Z",
        "cooked": "<p>Yes, her flip will be the first thing to resolve in the start of villain turn, and then her start of turn action on the reverse side will be the next thing to resolve.</p><p>There is a ruling precedence with Citizen Dawn that when a character card flips itself, an effect on the reverse side which resolves in the same phase will then resolve immediately.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T02:29:46.731Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 1,
        "readers_count": 0,
        "score": 0.2,
        "yours": false,
        "topic_id": 7349,
        "topic_slug": "miss-information-flips",
