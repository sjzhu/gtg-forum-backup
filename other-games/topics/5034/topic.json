        "display_username": "Paul",
        "primary_group_name": "playtesters",
        "flair_name": "Judges",
        "flair_url": "scale-balanced",
        "flair_bg_color": "7700ff",
        "flair_color": "",
        "flair_group_id": 42,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
