        "avatar_template": "/user_avatar/forums.greaterthangames.com/pydro/{size}/1844_2.png",
        "created_at": "2013-12-22T02:54:00.000Z",
        "cooked": "<p>Yes.</p><p>If something is required to be done for a secondary effect, it will outright say it. For example: \"If you do...\" or \"If they take damage this way...\"</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T03:08:36.146Z",
