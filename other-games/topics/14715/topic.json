        "avatar_template": "/user_avatar/forums.greaterthangames.com/the_burning_stickman/{size}/2003_2.png",
        "created_at": "2016-03-07T01:31:17.000Z",
        "cooked": "<p>You can test this out easily with Omnitron-X in the video game. If you use the Electro Deployment Unit to play another component, that second component will trigger that same start-of-turn.</p>",
        "post_number": 6,
        "post_type": 1,
