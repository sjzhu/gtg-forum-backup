        "id": 164917,
        "name": "dpt",
        "username": "dpt",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/dpt/{size}/1922_2.png",
        "created_at": "2016-03-06T20:39:24.000Z",
        "cooked": "<p>It's the same as for end of turn: if a card is played during the start of turn, then any start of turn effects trigger.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T04:46:12.765Z",
        "reply_count": 0,
        "reply_to_post_number": null,
