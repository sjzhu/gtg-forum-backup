      {
        "id": 163392,
        "name": "AlexxKay",
        "username": "AlexxKay",
        "avatar_template": "/letter_avatar_proxy/v4/letter/a/59ef9b/{size}.png",
        "created_at": "2016-02-22T19:22:39.000Z",
        "cooked": "<p>Wager Master says \"treat that card as if it had just been played.\" Seems pretty clear cut to me that that means it should be treated as if it entered play after all the other cards, and is thus processed AFTER any previously-played face up cards.</p><p>(If you ruled the other way, you could easily get into ambiguous situations where, due to the shuffling of face down cards, you didn't actually know what order the face up cards had entered play.)</p>",
        "post_number": 3,
        "post_type": 1,
        "updated_at": "2021-02-07T04:44:24.651Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
