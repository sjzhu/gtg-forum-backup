      {
        "id": 52527,
        "name": "TheJayMann",
        "username": "TheJayMann",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/thejaymann/{size}/2261_2.png",
        "created_at": "2013-01-24T23:59:18.000Z",
        "cooked": "<p>It's the total amount of cards picked up, not the amount per player, as the first scales linearly, while the latter scales exponentially (making a three player game much easier than a five player game, going against the attempt to have any number of players the same difficulty level).</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T02:26:27.258Z",
        "reply_count": 0,
        "reply_to_post_number": null,
