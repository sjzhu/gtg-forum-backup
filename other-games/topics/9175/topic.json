        "id": 85404,
        "name": "Pydro",
        "username": "Pydro",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/pydro/{size}/1844_2.png",
        "created_at": "2013-12-25T05:18:00.000Z",
        "cooked": "<p>Yes, because it is dependent on the damage, and dealing damage means their hp goes down. However, not everything is like this. Compare these wordings to something like Stunbolt. There, you don’t need to actually deal the damage.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T03:09:04.588Z",
        "reply_count": 0,
        "reply_to_post_number": null,
