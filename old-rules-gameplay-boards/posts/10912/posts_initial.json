      "can_see_hidden_post": false,
      "can_wiki": false,
      "read": true,
      "user_title": null,
      "bookmarked": false,
      "raw": "<p>Has anyone given thought to 2v2v2 or 3v3v3 skirmishes, with treats scoring a point for every incap they cause instead of tracking your own incaps? &nbsp;Was wondering as otherwise it&#39;s really har to run something with 3 players.&nbsp;</p>",
      "actions_summary": [],
      "moderator": false,
      "admin": false,
      "staff": false,
      "user_id": 8307,
      "hidden": false,
      "trust_level": 1,
      "deleted_at": null,
      "user_deleted": false,
      "edit_reason": null,
      "can_view_edit_history": true,
