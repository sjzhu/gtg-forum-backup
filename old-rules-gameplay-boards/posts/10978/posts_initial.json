      "bookmarked": false,
      "raw": "So, Luther, Absolute Zero can be damaged by his own Impaling Structures, and Ambuscade can be damaged by his own traps?\r\n\r\n(These are not Companions so your previous answer does not quite apply)",
      "actions_summary": [],
      "moderator": false,
      "admin": false,
      "staff": false,
      "user_id": 5124,
      "hidden": false,
      "trust_level": 2,
      "deleted_at": null,
      "user_deleted": false,
      "edit_reason": null,
