      "read": true,
      "user_title": null,
      "bookmarked": false,
      "raw": "<p>For ranged attacks do you count the hexes between you and your target or the hexes between plus the one the opponent is on?&nbsp;</p><p>For melee attacks from different elevations do you count that as range and would then remove the dice that aren&#39;t equal to or higher or since it&#39;s melee you only need to be adjacent and in the first instance would reach apply?&nbsp;</p>",
      "actions_summary": [],
      "moderator": false,
      "admin": false,
      "staff": false,
      "user_id": 3724,
      "hidden": false,
      "trust_level": 1,
      "deleted_at": null,
      "user_deleted": false,
      "edit_reason": null,
      "can_view_edit_history": true,
