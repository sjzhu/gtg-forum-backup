      "avatar_template": "/letter_avatar_proxy/v4/letter/s/8e7dd6/{size}.png",
      "created_at": "2014-08-20T00:09:02.000Z",
      "cooked": "<p>For ranged attacks do you count the hexes between you and your target or the hexes between plus the one the opponent is on?&nbsp;</p><p>For melee attacks from different elevations do you count that as range and would then remove the dice that aren't equal to or higher or since it's melee you only need to be adjacent and in the first instance would reach apply?&nbsp;</p>",
      "post_number": 1,
      "post_type": 1,
      "updated_at": "2021-02-07T01:42:16.466Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 9,
      "reads": 0,
      "readers_count": 0,
      "score": 45.0,
      "yours": false,
      "topic_id": 11055,
      "topic_slug": "range-reach-and-melee",
      "display_username": "skibud555",
      "primary_group_name": null,
