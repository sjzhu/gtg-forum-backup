        "read": true,
        "user_title": null,
        "bookmarked": false,
        "raw": "<p>Hazard Spaces only trigger when a target moves into a Hazard Space or if they end their turn in a Hazard Space. A Hex becoming a Hazard Space is neither of those.</p>",
        "actions_summary": [],
        "moderator": false,
        "admin": false,
        "staff": false,
        "user_id": 10,
