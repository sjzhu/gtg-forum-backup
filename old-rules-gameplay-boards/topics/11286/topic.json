        "user_title": null,
        "bookmarked": false,
        "raw": "<p>I don&#39;t know the scenario well, but if Ambuscade overkill&#39;s someone and pushes them out &nbsp;of the path of the train, does that help?</p>",
        "actions_summary": [],
        "moderator": true,
        "admin": false,
        "staff": true,
        "user_id": 18,
        "hidden": false,
        "trust_level": 4,
        "deleted_at": null,
        "user_deleted": false,
        "edit_reason": null,
        "can_view_edit_history": true,
