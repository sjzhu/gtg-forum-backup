        "avatar_template": "/user_avatar/forums.greaterthangames.com/grysqrl/{size}/1909_2.png",
        "created_at": "2014-10-17T14:36:47.000Z",
        "cooked": "<p>You should actually only need one coat of matte varnish. If you want more than 2 total coats, use multiple coats of gloss and then one matte over them. Overall protection will be better that way.</p>",
        "post_number": 8,
        "post_type": 1,
