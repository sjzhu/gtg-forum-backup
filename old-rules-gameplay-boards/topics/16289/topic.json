        "avatar_template": "/letter_avatar_proxy/v4/letter/e/ecccb3/{size}.png",
        "created_at": "2017-03-10T04:34:09.000Z",
        "cooked": "<p>Just picked this up and think I got the rules down (haven't played it yet) but the only question I have is what happens when a character gets incapped during its power phase? Does it just reroll and continue or does it \"skip\" his turn. Rules say replace health and reroll and thats it.</p><p>&nbsp;</p><p>Thanks</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:48:57.856Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 17,
        "reads": 15,
        "readers_count": 14,
        "score": 88.0,
        "yours": false,
        "topic_id": 16289,
        "topic_slug": "question-about-incap-during-power-phase",
        "display_username": "Enbalmination",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
