        "bookmarked": false,
        "raw": "<p>Is push mandatory? &nbsp;If I hit someone with Proletariat, do I HAVE to push them or can I decide not to?</p>",
        "actions_summary": [],
        "moderator": false,
        "admin": false,
        "staff": false,
        "user_id": 4238,
