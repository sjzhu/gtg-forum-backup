        "id": 10495,
        "name": "IKerensky",
        "username": "IKerensky",
        "avatar_template": "/letter_avatar_proxy/v4/letter/i/df705f/{size}.png",
        "created_at": "2014-06-07T00:14:57.000Z",
        "cooked": "<p>Showed the game to about a dozen of people and everyone of them have commented about the picture being smallish, the text hard to read and the ample wasted borders and empty space on the cards.</p><p>Why did you decide on using that design ? Did the playtesters tested it ? No one complained about it before printing ?</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:41:33.701Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 1,
        "reads": 1,
        "readers_count": 0,
        "score": 5.2,
        "yours": false,
        "topic_id": 10496,
        "topic_slug": "gsf-why-are-the-picture-and-texts-so-small",
        "display_username": "IKerensky",
        "primary_group_name": null,
