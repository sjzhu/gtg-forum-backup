    "posts": [
      {
        "id": 11765,
        "name": "payprplayn",
        "username": "payprplayn",
        "avatar_template": "/letter_avatar_proxy/v4/letter/p/b2d939/{size}.png",
        "created_at": "2014-12-30T06:05:49.000Z",
        "cooked": "<p><span>Does the static \"Move value +1\" from \"The World Stands Still\"&nbsp;</span><strong>apply&nbsp;</strong><span>&nbsp;to Tachyon's current movement value, whatever it is, or is it simply&nbsp;</span><strong>added</strong><span>&nbsp;to her movement value whenever she rolls movement? &nbsp;In other words, if I rolled 6 for movement, then got hit with adhesive foam pellets, would my movement value be reduced from 7 to 1 or from 6+1(=7) to 1+1(=2)?</span></p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:43:08.555Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 1,
        "reads": 0,
        "readers_count": 0,
        "score": 5.0,
        "yours": false,
        "topic_id": 11763,
        "topic_slug": "the-world-stands-still",
        "display_username": "payprplayn",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
