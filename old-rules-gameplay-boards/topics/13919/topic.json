      {
        "id": 151028,
        "name": "phantaskippy",
        "username": "phantaskippy",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/phantaskippy/{size}/1897_2.png",
        "created_at": "2015-12-01T01:25:35.000Z",
        "cooked": "<p>Bolstering Team-Up lets Beacon take an action. &nbsp;The action chosen will follow all normal rules.</p><p>Overwhelm says to select an action, not use it. &nbsp;Each Proletariat takes that action. &nbsp;You are not using the selected action, Overwhelm is giving you the effect of that action for each Proletariat.</p><p>&nbsp;</p><p>That is the difference.</p>",
        "post_number": 3,
        "post_type": 1,
        "updated_at": "2021-02-07T04:29:46.923Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 0,
        "readers_count": 0,
        "score": 0.0,
        "yours": false,
        "topic_id": 13919,
        "topic_slug": "getting-additional-action-uses",
        "display_username": "phantaskippy",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
