      {
        "id": 115236,
        "name": "truednd",
        "username": "truednd",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/truednd/{size}/2419_2.png",
        "created_at": "2014-08-18T19:52:40.000Z",
        "cooked": "<p>AS I understand it, and anyone please correct me if I am wrong:</p><p>&nbsp;</p><p>For Vertexs, you cou t the number of hexes away from Bunker, then you choose a vertex on the hex chosen. Figures on the 3 hexs adjacent to that vertex will be hit.</p><p>&nbsp;</p><p>For reach, it should only affect the die and not your actual range keeping in mind that the die result itself is unaffected. Meaning that if you roll a 1 with reach 3 against a target 4 spaces away, you still hit your target (1+3=4) but the die result itself is unchanged.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T03:47:21.497Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 0,
        "readers_count": 0,
        "score": 0.0,
        "yours": false,
        "topic_id": 11019,
        "topic_slug": "reach-and-origin-and-vertex-attacks",
        "display_username": "truednd",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
        "can_delete": false,
        "can_recover": false,
        "can_see_hidden_post": false,
        "can_wiki": false,
        "read": true,
        "user_title": null,
        "bookmarked": false,
        "raw": "<p>AS I understand it, and anyone please correct me if I am wrong:</p><p>&nbsp;</p><p>For Vertexs, you cou t the number of hexes away from Bunker, then you choose a vertex on the hex chosen. Figures on the 3 hexs adjacent to that vertex will be hit.</p><p>&nbsp;</p><p>For reach, it should only affect the die and not your actual range keeping in mind that the die result itself is unaffected. Meaning that if you roll a 1 with reach 3 against a target 4 spaces away, you still hit your target (1+3=4) but the die result itself is unchanged.</p>",
        "actions_summary": [],
        "moderator": false,
        "admin": false,
        "staff": false,
        "user_id": 7896,
