      {
        "id": 116831,
        "name": "SeraAlexandria",
        "username": "SeraAlexandria",
        "avatar_template": "/letter_avatar_proxy/v4/letter/s/4491bb/{size}.png",
        "created_at": "2014-09-01T22:09:43.000Z",
        "cooked": "<p>I do it the way match described. Everyone picks the ones they want and places them face down, then all are revealed at once. That way nobody has an advantage over anyone else.</p>",
        "post_number": 9,
        "post_type": 1,
        "updated_at": "2021-02-07T03:49:21.470Z",
        "reply_count": 0,
