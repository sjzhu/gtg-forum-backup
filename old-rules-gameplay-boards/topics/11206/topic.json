        "read": true,
        "user_title": null,
        "bookmarked": false,
        "raw": "<p>Playtesters - when you were doing skirmishes, was there ever an issue of who chose powers first? &nbsp;I can imagine a scenario where it matters, because my optimal choice of power might depend on which power you choose, and vice versa.</p>",
        "actions_summary": [],
        "moderator": false,
        "admin": false,
