        "user_title": null,
        "bookmarked": false,
        "raw": "<p>A question came up last time I played. If someone begins tracing the line of sight straight from the vertex of the hex they are in and the target hex is on the line several hexes away, does that mean you you have line of sight? They measured it this way because the hexes on the line before the target allowed LOS on one side and didn&#39;t on the other side.</p>",
        "actions_summary": [],
        "moderator": false,
        "admin": false,
        "staff": false,
        "user_id": 8745,
        "hidden": false,
        "trust_level": 1,
