    {
      "id": 233706,
      "name": "Sonvar",
      "username": "Powerhound_2000",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/powerhound_2000/{size}/1859_2.png",
      "created_at": "2020-09-04T13:26:02.000Z",
      "cooked": "<p>Here’s a ruling&nbsp;from the Fireside chats that talks about how the value of X is dynamic:</p>\n<aside class=\"quote no-group\" data-username=\"Fireside chats\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n Fireside chats:</div>\n<blockquote>\n<br>\nIf&nbsp;Black Hole Generator destroys a device target while dealing damage, the amount of damage dealt to the next target increases by 1, since X&nbsp;updates dynamically. Similarly, when it destroys a device environment card, the number of card destructions increases by 1, since X updates&nbsp;dynamically.\n</blockquote>\n</aside>",
      "post_number": 5,
      "post_type": 1,
      "updated_at": "2021-02-07T06:09:36.413Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 3,
      "readers_count": 2,
      "score": 0.6,
      "yours": false,
      "topic_id": 20236,
      "topic_slug": "devious-disruption-can-the-damage-change",
      "display_username": "Sonvar",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
      "flair_color": "",
      "flair_group_id": 41,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
      "can_delete": false,
      "can_recover": false,
      "can_see_hidden_post": false,
      "can_wiki": false,
      "read": false,
      "user_title": "",
      "bookmarked": false,
      "raw": "Here's a ruling&nbsp;from the Fireside chats that talks about how the value of X is dynamic:\n\n[quote=\"Fireside chats\"]\n<br />\nIf&nbsp;Black Hole Generator destroys a device target while dealing damage, the amount of damage dealt to the next target increases by 1, since X&nbsp;updates dynamically. Similarly, when it destroys a device environment card, the number of card destructions increases by 1, since X updates&nbsp;dynamically.\n\n[/quote]\n\n",
