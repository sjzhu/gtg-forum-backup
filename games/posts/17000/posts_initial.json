      "avatar_template": "/user_avatar/forums.greaterthangames.com/chaosmancer/{size}/1977_2.png",
      "created_at": "2017-08-09T03:04:20.000Z",
      "cooked": "<p>Woah, I would never have expected that answer. That power just got a lot better if you can hit that threshold</p>",
      "post_number": 8,
      "post_type": 1,
      "updated_at": "2021-02-07T05:29:56.476Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
