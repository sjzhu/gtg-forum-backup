      "id": 229979,
      "name": "Blackfang108",
      "username": "Blackfang108",
      "avatar_template": "/letter_avatar_proxy/v4/letter/b/74df32/{size}.png",
      "created_at": "2020-03-17T14:26:00.000Z",
      "cooked": "<p>I originally tried to focus on SS, but Hold the Line kept <font color=\"green\"><strong>Removed by Mod</strong></font>&nbsp;coming up.</p>\n<p>Took out Ermine, then started on SS, bought him down low and kicked MI below 4, and the environment killed both of them in the same turn.</p>\n<p>Then La Capitan gulped when Chiquito was eaten by Writhe and he repeatedly stabbed her with the Umbral Siphon.</p>",
      "post_number": 8,
      "post_type": 1,
      "updated_at": "2021-02-07T06:04:51.884Z",
      "reply_count": 0,
      "reply_to_post_number": null,
