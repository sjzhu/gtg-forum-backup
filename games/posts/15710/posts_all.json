      "id": 182844,
      "name": "Sonvar",
      "username": "Powerhound_2000",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/powerhound_2000/{size}/1859_2.png",
      "created_at": "2016-09-24T12:12:25.000Z",
      "cooked": "<p>The wording is a little different than Provocator Tarnis but I had been under the same impression originally. &nbsp;The wording on Tarnis this</p><p>\n&gt; </p><p>The first time a &nbsp;villain target other than this card would be dealt damage each turn, redirect that damage to this card.</p><p>\n</p><p>Wrong Time and Place says this&nbsp;</p><p>\n&gt; </p><p><span>The first time a hero target would be dealt damage each turn, redirect that damage to Setback, or remove X tokens from your unlucky pool to redirect that damage to a target, where X = the amount of damage. &nbsp;</span></p><p><span>\n</span></p><p><span>In Setback's case it also makes more sense as only having to deal with only the first time any hero was dealt damage each turn makes Wrong Time and Place a fairly safe play. &nbsp;</span></p>",
      "post_number": 4,
      "post_type": 1,
      "updated_at": "2021-02-07T05:07:56.236Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 15710,
      "topic_slug": "how-does-wrong-time-and-place-work",
      "display_username": "Sonvar",
      "primary_group_name": "playtesters",
      "flair_name": "playtesters",
      "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
      "flair_bg_color": "",
