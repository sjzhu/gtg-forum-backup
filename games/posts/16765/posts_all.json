      "avatar_template": "/letter_avatar_proxy/v4/letter/r/76d3ee/{size}.png",
      "created_at": "2017-06-21T11:26:31.000Z",
      "cooked": "<p>If you didn't watch the newest twitch episode yesterday, shame on you ;P</p><p>Here are some news, a card of Knyfe was changed.&nbsp;</p><p>Focusing Conduit-Blade reads \"When this card is destroyed, you may play an quipment card\".&nbsp;</p><p>The new text is \"After this card is destroyed...\", now it's possible to play a second Focusing Conduit-Blade right after the first one.</p><p>i like the change, wooohooo ;P</p>",
      "post_number": 1,
      "post_type": 1,
      "updated_at": "2021-02-07T01:49:36.823Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 1,
      "reads": 0,
      "readers_count": 0,
      "score": 5.0,
