    {
      "id": 254727,
      "name": "WalkingTarget",
      "username": "WalkingTarget",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/walkingtarget/{size}/4833_2.png",
      "created_at": "2023-10-21T18:54:24.076Z",
      "cooked": "<p>My opinion regarding how late they can make a new thing for DE is related to <em>The History of Sentinel Comics</em>.</p>\n<p>One can presume that anyone important enough to have a deck would be mentioned in this book. Granted, it’s continued to get pushed back, but my guess regarding it is that we’re not going to be surprised by characters appearing in the book before they discuss them anywhere else.</p>\n<p>In short: anyone getting a deck will have been created by the time the text of the book is finalized and will likely be mentioned on the podcast before it ships.</p>",
      "post_number": 14,
      "post_type": 1,
      "updated_at": "2023-10-21T18:54:24.076Z",
      "reply_count": 1,
      "reply_to_post_number": null,
