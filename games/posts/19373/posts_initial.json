      "id": 228486,
      "name": "pwatson1974",
      "username": "pwatson1974",
      "avatar_template": "/user_avatar/forums.greaterthangames.com/pwatson1974/{size}/1925_2.png",
      "created_at": "2019-08-15T11:37:50.000Z",
      "cooked": "<p>The game breaks with only 2 heroes. It screws up the (H) mechanism. This is not currently sufficiently clear in the rulebook.</p>\n<p>&nbsp;</p>\n<p>For 2 players, at least one of them needs to play multiple heroes. Setting (H) at a minimum of 3 might also work, but I haven’t tried that.</p>",
      "post_number": 2,
      "post_type": 1,
      "updated_at": "2021-02-07T06:02:59.195Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 6,
      "readers_count": 5,
      "score": 1.2,
      "yours": false,
      "topic_id": 19373,
      "topic_slug": "a-oddly-broken-game",
