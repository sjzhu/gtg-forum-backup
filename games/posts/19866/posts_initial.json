      "id": 230285,
      "name": "catDreaming",
      "username": "catDreaming",
      "avatar_template": "/letter_avatar_proxy/v4/letter/c/4491bb/{size}.png",
      "created_at": "2020-04-22T15:11:16.000Z",
      "cooked": "<p>I actually find Wraith to be quite powerful. She has a variety of damage types, solid mobility, and if the target is hit with an evasion debuff, Knife Throw suddenly becomes a pretty good way to get in some extra chip damage.</p>",
      "post_number": 9,
      "post_type": 1,
      "updated_at": "2021-02-07T06:05:14.702Z",
      "reply_count": 0,
