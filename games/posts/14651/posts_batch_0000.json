        "avatar_template": "/user_avatar/forums.greaterthangames.com/mariofanaticxv/{size}/2129_2.png",
        "created_at": "2016-03-03T23:06:54.000Z",
        "cooked": "<p>The only thing I dislike about the chat interface is that it's locked into capitals all the time; I want my lowercase...<br><br>That being said, a voice chat system would be optimal.</p>",
        "post_number": 29,
        "post_type": 1,
        "updated_at": "2021-02-07T04:44:43.420Z",
        "reply_count": 0,
