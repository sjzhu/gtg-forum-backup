    {
      "id": 172964,
      "name": "jorgenp",
      "username": "jorgenp",
      "avatar_template": "/letter_avatar_proxy/v4/letter/j/958977/{size}.png",
      "created_at": "2016-04-14T07:48:24.000Z",
      "cooked": "<p>That sounds like a fun bug to fix.</p><p>&nbsp;</p><p>Now...&nbsp; in the spirit of Mythbusters, let's take this experiment to the extreme...</p><p>&nbsp;</p><p>Try to get a chain of all three Vitality Conduits and all three Autonomous Blades attached to each other in one long chain, with the lowest in the chain one attached to Bloogo before Bloogo attaches to the topmost one...</p><p>&nbsp;</p><p>Perhaps putting Chastise on Bloogo too would help with this.</p>",
      "post_number": 7,
      "post_type": 1,
      "updated_at": "2021-02-07T04:56:00.168Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 0,
      "reads": 0,
      "readers_count": 0,
      "score": 0.0,
      "yours": false,
      "topic_id": 15043,
      "topic_slug": "can-you-figure-out-what-i-did",
      "display_username": "jorgenp",
      "primary_group_name": null,
      "flair_name": null,
      "flair_url": null,
      "flair_bg_color": null,
      "flair_color": null,
      "flair_group_id": null,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
      "can_delete": false,
      "can_recover": false,
      "can_see_hidden_post": false,
      "can_wiki": false,
      "read": false,
      "user_title": null,
      "bookmarked": false,
      "raw": "<p>That sounds like a fun bug to fix.</p><p>&nbsp;</p><p>Now...&nbsp; in the spirit of Mythbusters, let&#39;s take this experiment to the extreme...</p><p>&nbsp;</p><p>Try to get a chain of all three Vitality Conduits and all three Autonomous Blades attached to each other in one long chain, with the lowest in the chain one attached to Bloogo before Bloogo attaches to the topmost one...</p><p>&nbsp;</p><p>Perhaps putting Chastise on Bloogo too would help with this.</p>",
