      "id": 19918,
      "name": "christian.ian.cruze",
      "username": "christian.ian.cruze",
      "avatar_template": "/letter_avatar_proxy/v4/letter/c/ee7513/{size}.png",
      "created_at": "2020-05-13T01:39:55.000Z",
      "cooked": "<p>Hey all!</p>\n<p>I'm super pumped the core rulebook is out (at least for backers) and I'm enjoying all the reading of the previously unrealeased content. Props to all involved! It looks great!</p>\n<p>My only concern is the PDF seems to be loading really slowly for me. I'm trying to read through page by page and I find myself having to wait for each page to load. Is anyone else having this trouble? I know the PDF is a huge file--is there a way to compress the file or change some setting to make pages load faster? I'm just trying to imagine quick scrolling and it doesn't seem possible unless I'm doing something wrong.</p>\n<p>Help?</p>",
      "post_number": 1,
      "post_type": 1,
      "updated_at": "2021-02-07T01:53:47.534Z",
      "reply_count": 0,
      "reply_to_post_number": null,
      "quote_count": 0,
      "incoming_link_count": 219,
      "reads": 8,
      "readers_count": 7,
      "score": 1096.6,
      "yours": false,
      "topic_id": 19917,
      "topic_slug": "core-rulebook-pdf",
      "display_username": "christian.ian.cruze",
      "primary_group_name": null,
      "flair_name": null,
      "flair_url": null,
      "flair_bg_color": null,
      "flair_color": null,
      "flair_group_id": null,
      "badges_granted": [],
      "version": 1,
      "can_edit": false,
