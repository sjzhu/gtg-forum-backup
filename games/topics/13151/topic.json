        "readers_count": 0,
        "score": 0.0,
        "yours": false,
        "topic_id": 13151,
        "topic_slug": "plague-rat-vs-absolute-zero-the-visionary-and-tempest-in-the-ruins-of-atlantis",
        "display_username": "The Burning Stickman",
        "primary_group_name": null,
        "flair_name": null,
