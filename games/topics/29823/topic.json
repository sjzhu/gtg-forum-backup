        "created_at": "2023-01-13T18:40:26.101Z",
        "cooked": "<p>I only have Horizons of Spirit Island, just bought it yesterday.  I got an email advertising the Spirit Island Classic Panel Boards, but it is confusing not already knowing about the game. A couple of questions:</p>\n<ul>\n<li>Does this add any content to Horizons of Spirit Island?</li>\n<li>Is this just a materials issue, and only really interesting to Spirit Island owners who are putting HoSI materials into their SI games?</li>\n<li>Shipping is more than the cost of this product, is it possible it will be availalbe in retail stores or at conventions?</li>\n</ul>\n<p>Thanks</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2023-01-13T18:40:54.774Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 18,
        "reads": 25,
        "readers_count": 24,
        "score": 95.0,
        "yours": false,
        "topic_id": 29823,
        "topic_slug": "new-spirit-panel-boards",
        "display_username": "Ric Bretschneider",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
