      {
        "id": 227766,
        "name": "carnilius",
        "username": "carnilius",
        "avatar_template": "/letter_avatar_proxy/v4/letter/c/d07c76/{size}.png",
        "created_at": "2019-06-06T17:42:43.000Z",
        "cooked": "<p>I always face a debate in ordering Team Leader Tachyon, Legacy, and Argent Adept. &nbsp;TLT is great in first position, because she can set everyone up with the cards they need. &nbsp;Legacy is great first so he can boost everyone else, and play Take Down after his turn instead of before it (with AA). &nbsp;Argent Adept is helpful for setup, so is sometimes better earlier.</p>",
        "post_number": 8,
        "post_type": 1,
        "updated_at": "2021-02-07T06:02:02.090Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 2,
        "readers_count": 1,
        "score": 0.4,
        "yours": false,
        "topic_id": 19242,
        "topic_slug": "player-order-vs-character",
        "display_username": "carnilius",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
