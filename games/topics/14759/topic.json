      {
        "id": 165972,
        "name": "Leovigild",
        "username": "Leovigild",
        "avatar_template": "/letter_avatar_proxy/v4/letter/l/3ec8ea/{size}.png",
        "created_at": "2016-03-14T14:57:31.000Z",
        "cooked": "<p>Correct, you can't copyright game mechanics. If another company was reproducing the art or the text on the cards, or using the trademarked characters, then no. Otherwise, it is available to everyone.</p>",
        "post_number": 7,
        "post_type": 1,
        "updated_at": "2021-02-07T04:47:29.709Z",
        "reply_count": 0,
        "reply_to_post_number": null,
