        "topic_id": 30250,
        "topic_slug": "de-difficulty-level-of-critical-events-relative-to-their-villains-standard-difficulty",
        "display_username": "Kento",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
