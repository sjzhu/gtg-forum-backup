      {
        "id": 150060,
        "name": "dpt",
        "username": "dpt",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/dpt/{size}/1922_2.png",
        "created_at": "2015-11-02T22:37:07.000Z",
        "cooked": "<p>&gt;G will be sending out a survey at some point to clarify exactly which reward you want. That's your first chance to give an address. After that, in the past, the way to update your address is to e-mail them directly, and they will update it in their system. They'll also send out a reminder e-mail a couple of weeks before they actually start shipping, just to remind you to give an updated address then. (Or, at least, that's what they've done on previous recent Kickstarter/preorder campaigns.)</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T04:28:38.700Z",
