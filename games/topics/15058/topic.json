        "readers_count": 0,
        "score": 0.0,
        "yours": false,
        "topic_id": 15058,
        "topic_slug": "chaos-lord-and-kaargra",
        "display_username": "Kratos13",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
