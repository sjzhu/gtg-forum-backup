        "avatar_template": "/user_avatar/forums.greaterthangames.com/harknail/{size}/1972_2.png",
        "created_at": "2020-09-13T06:23:46.000Z",
        "cooked": "<p>Minion-Maker description (p87) says that minions only last for the current scene. Then it says:&nbsp;</p>\n<p>\"You may be able to have more permanent helpers based on story development; see pages&nbsp;142-143 for details.\"</p>\n<p>But pages 142-143 (Hero Advancement) say nothing about permanent helpers.&nbsp;</p>\n<p>Any suggestions?</p>\n<p>The best I can come up with is to allow spending a collection to start a scene with a minion, for scenes where that makes sense (heroes at scene for a while before action starts).</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:54:17.383Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 32,
        "reads": 3,
        "readers_count": 2,
        "score": 160.6,
        "yours": false,
        "topic_id": 20258,
        "topic_slug": "permanent-minions",
        "display_username": "Harknail",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
