      {
        "id": 149652,
        "name": "Donner",
        "username": "Donner",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/donner/{size}/1903_2.png",
        "created_at": "2015-10-17T05:36:23.000Z",
        "cooked": "<p>On average, he destroys a bit over 3 environment cards every 2 turns.&nbsp; The environment deck has 15 cards.&nbsp; That gives you a bit under 10 rounds to defeat him.</p>",
