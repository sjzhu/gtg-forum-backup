        "id": 19997,
        "name": "ric.revans",
        "username": "ric.revans",
        "avatar_template": "/letter_avatar_proxy/v4/letter/r/a4c791/{size}.png",
        "created_at": "2020-06-16T17:36:15.000Z",
        "cooked": "<p>One of my players has built a form changer as a new hero. &nbsp;(thanks to Pike Industry's Stirling safety records)</p>\n<p>this has led to a couple of questions.</p>\n<p>1/ Uncaged has a green power already before taking form changer. Is this lost while in one of the 3 forms? As an add on do they also keep yellow and red abilities?</p>\n<p>2/ while I'm inclined to allow it personally, if Uncaged transforms into a bird presumably shape change allows them to fly, just not well? What do people think?</p>\n<p>3/ is there any harm to allowing powers and qualities being swapped around, I know the description says powers, but they have the stealth quality and a Hippo form, the player makes excellent argument that Hippo's are not nessarily well known for stealth.</p>\n<p>&nbsp;</p>\n<p>thanks for your thoughts</p>\n<p>richard&nbsp;</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:53:54.405Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 16,
        "reads": 3,
        "readers_count": 2,
        "score": 80.6,
        "yours": false,
        "topic_id": 19996,
        "topic_slug": "a-question-or-two-about-form-chnager",
        "display_username": "ric.revans",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
        "can_delete": false,
        "can_recover": false,
        "can_see_hidden_post": false,
        "can_wiki": false,
        "read": false,
        "user_title": null,
        "bookmarked": false,
        "raw": "<p>One of my players has built a form changer as a new hero. &nbsp;(thanks to Pike Industry's Stirling safety records)</p>\r\n\r\n<p>this has led to a couple of questions.</p>\r\n\r\n<p>1/ Uncaged has a green power already before taking form changer. Is this lost while in one of the 3 forms? As an add on do they also keep yellow and red abilities?</p>\r\n\r\n<p>2/ while I'm inclined to allow it personally, if Uncaged transforms into a bird presumably shape change allows them to fly, just not well? What do people think?</p>\r\n\r\n<p>3/ is there any harm to allowing powers and qualities being swapped around, I know the description says powers, but they have the stealth quality and a Hippo form, the player makes excellent argument that Hippo's are not nessarily well known for stealth.</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>thanks for your thoughts</p>\r\n\r\n<p>richard&nbsp;</p>",
