        "topic_slug": "the-next-tourment-of-sentinels-of-the-multiverse",
        "display_username": "Tophatlord",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
