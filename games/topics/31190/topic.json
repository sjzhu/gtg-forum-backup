        "username": "Omegatron",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/omegatron/{size}/4904_2.png",
        "created_at": "2024-10-20T11:37:44.065Z",
        "cooked": "<p>You’re right in that you have to go in order down the power source. The bonus powers from those power sources won’t be available for the abilities gained from the power source, as the bonus power is gained after the abilities.</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2024-10-20T11:37:44.065Z",
