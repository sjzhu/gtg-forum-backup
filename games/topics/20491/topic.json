      {
        "id": 20491,
        "name": "Matanui3",
        "username": "Matanui3",
        "avatar_template": "/letter_avatar_proxy/v4/letter/m/87869e/{size}.png",
        "created_at": "2021-01-06T22:04:47.000Z",
        "cooked": "<p>I'm planning on running the Starter Kit for two of my friends, but I have trepidations about action economy issues - most TTRPG games and scenarios are written for around four people, and half that usually requires adjustments.&nbsp; Has anybody tried the starter kit with small numbers of players, and if so, how does it generally go?</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:54:36.850Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 2,
        "reads": 8,
        "readers_count": 7,
        "score": 11.6,
        "yours": false,
        "topic_id": 20491,
        "topic_slug": "is-action-economy-an-issue-for-two-players",
        "display_username": "Matanui3",
        "primary_group_name": null,
