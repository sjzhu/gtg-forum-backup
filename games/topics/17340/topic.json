        "avatar_template": "/letter_avatar_proxy/v4/letter/t/f08c70/{size}.png",
        "created_at": "2017-10-31T20:28:56.000Z",
        "cooked": "<p>This should have very little effect, especially if you included the expansion power cards.</p>",
