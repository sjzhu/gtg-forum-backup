        "id": 236670,
        "name": "Sea-Envy",
        "username": "Sea-Envy",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/sea-envy/{size}/1849_2.png",
        "created_at": "2021-04-08T09:54:59.528Z",
        "cooked": "<p>yes, you would get your boost and then switch modes<br>\nyou will have more than one mode but you can only be in one mode at a time<br>\nyou have a default green mode with no special effects<br>\n1 other green mode from the list of 3<br>\n2 yellow modes from the list of 5<br>\n1 red mode from the list of 3<br>\nThe Form Changer’s forms and the Modular’s modes basically work the same it changes up your power dice in a way described in the archetype rules and gives you an ability only usable when that option is “on”</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-04-08T09:54:59.528Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 23,
        "readers_count": 22,
        "score": 49.6,
        "yours": false,
        "topic_id": 28387,
        "topic_slug": "modular-archetype-question",
        "display_username": "Sea-Envy",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
