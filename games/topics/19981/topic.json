      {
        "id": 231117,
        "name": "KateWalker",
        "username": "TakeWalker",
        "avatar_template": "/user_avatar/forums.greaterthangames.com/takewalker/{size}/5677_2.png",
        "created_at": "2020-06-15T12:41:21.000Z",
        "cooked": "<p>If flying is all they can really do, no blasting or guns or anything, then they're going to be coming in to punch things themselves unless they're pure support. That leaves them vulnerable to counterattacks!</p>",
        "post_number": 5,
        "post_type": 1,
        "updated_at": "2021-02-07T06:06:17.535Z",
        "reply_count": 0,
        "reply_to_post_number": null,
