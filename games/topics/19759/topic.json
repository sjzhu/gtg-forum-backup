      {
        "id": 229895,
        "name": "catDreaming",
        "username": "catDreaming",
        "avatar_template": "/letter_avatar_proxy/v4/letter/c/4491bb/{size}.png",
        "created_at": "2020-03-04T01:53:00.000Z",
        "cooked": "<p>For the multiple enemies + Punishment question, I would say that the die is modified selectively for each target.</p>\n<p>For Frontline Fighting, since it does not specify a 'basic Attack action', I believe that the target can still use abilities. Their action(s) on their turn&nbsp;just need&nbsp;to include an Attack on/involving the user of Frontline Fighting</p>",
        "post_number": 2,
        "post_type": 1,
        "updated_at": "2021-02-07T06:04:45.662Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 1,
        "readers_count": 0,
        "score": 0.2,
        "yours": false,
        "topic_id": 19759,
        "topic_slug": "quick-ability-questions",
        "display_username": "catDreaming",
        "primary_group_name": null,
        "flair_name": null,
        "flair_url": null,
        "flair_bg_color": null,
        "flair_color": null,
        "flair_group_id": null,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
