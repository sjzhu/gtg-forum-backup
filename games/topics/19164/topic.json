      {
        "id": 227334,
        "name": "Blackfang108",
        "username": "Blackfang108",
        "avatar_template": "/letter_avatar_proxy/v4/letter/b/74df32/{size}.png",
        "created_at": "2019-05-02T14:30:00.000Z",
        "cooked": "<aside class=\"quote no-group\" data-username=\"Glamour\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n Glamour:</div>\n<blockquote>\n<p>The first time a Nemesis card would be dealt damage by a Hero target each turn, redirect that damage to the Hero target with the highest HP.</p>\n</blockquote>\n</aside>\n<p>&nbsp;</p>\n<aside class=\"quote no-group\" data-username=\"Backlash Generator\">\n<div class=\"title\">\n<div class=\"quote-controls\"></div>\n Backlash Generator:</div>\n<blockquote>\n<p>The first time any Device is dealt damage by a non-Hero target each turn, this card deals the source of that damage 1 Lightning Damage.</p>\n</blockquote>\n</aside>\n<p>&nbsp;</p>\n<p>So, I guess the difference is “any” instead of “a”.</p>",
        "post_number": 3,
        "post_type": 1,
        "updated_at": "2021-02-07T06:01:30.348Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 0,
        "reads": 1,
        "readers_count": 0,
        "score": 0.2,
        "yours": false,
        "topic_id": 19164,
        "topic_slug": "which-kind-of-first-time-any-target-is-backlash-generator",
        "display_username": "Blackfang108",
        "primary_group_name": "playtesters",
        "flair_name": "playtesters",
        "flair_url": "/uploads/default/original/1X/f46928191dbf93b4d0df24571543f49779579225.png",
        "flair_bg_color": "",
        "flair_color": "",
        "flair_group_id": 41,
        "badges_granted": [],
        "version": 1,
        "can_edit": false,
