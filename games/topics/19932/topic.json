        "avatar_template": "/letter_avatar_proxy/v4/letter/c/edb3f5/{size}.png",
        "created_at": "2020-05-25T04:01:08.000Z",
        "cooked": "<p>Hello everyone -&nbsp;</p>\n<p>A couple questions -&nbsp;</p>\n<p>1) Is there a way to determine how much a character can lift?</p>\n<p>2) Is there a way to determine how fast a character can move (run, fly, etc)?</p>\n<p>I'm curious, and it's bound to come up sooner or later!&nbsp;&nbsp;</p>",
        "post_number": 1,
        "post_type": 1,
        "updated_at": "2021-02-07T01:53:48.846Z",
        "reply_count": 0,
        "reply_to_post_number": null,
        "quote_count": 0,
        "incoming_link_count": 2,
        "reads": 6,
